# Flask Environment Configuration
SECRET_KEY=truthlens_secret_key_super_secure_2026
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL by default, auto-falls back to SQLite if MySQL is unreachable)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=truthlens_db

# SQLite Fallback Path (Used automatically if DB_TYPE is sqlite or MySQL connection fails)
SQLITE_DB_PATH=truthlens.db
